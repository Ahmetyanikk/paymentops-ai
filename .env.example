# Copy to .env and fill in. NEVER commit .env.

# --- Storage ---
# Local dev (no Docker):  sqlite+pysqlite:///./paymentops.db
# Docker Compose:         postgresql+psycopg://paymentops:paymentops@postgres:5432/paymentops
DATABASE_URL=sqlite+pysqlite:///./paymentops.db

# Empty => embedded in-memory Qdrant (dev/test). Docker Compose: http://qdrant:6333
QDRANT_URL=
QDRANT_COLLECTION=dispute_policies

# LangGraph checkpoint store when DATABASE_URL is not PostgreSQL.
CHECKPOINT_DB=./checkpoints.sqlite

# --- LLM ---
# mock      => deterministic rule-based assessor (default; no network, used by tests)
# anthropic => real Claude call
LLM_PROVIDER=mock
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Deterministic eligibility (never decided by the LLM) ---
DISPUTE_FILING_WINDOW_DAYS=60
HIGH_VALUE_MINOR=500000

# --- Crash recovery ---
# Bounded lease timeout: a RUNNING intake or a DECIDING claim older than
# this is considered abandoned and safe to reclaim. Keep comfortably longer
# than any real request ever takes.
STUCK_CLAIM_TIMEOUT_SECONDS=20

# --- Reviewer authentication ---
# Required for POST /v1/investigations/{case_id}/decision.
# Format: "name1:key1,name2:key2". Empty => every decision request is
# rejected (fail closed, not open). Demo-only values - replace for any real
# deployment and keep real keys out of the repository.
REVIEWER_API_KEYS=cfo@example.com:demo-reviewer-key
